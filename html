<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Be My Date? 💌</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      overflow-x: hidden;
      font-family: "Quicksand", Georgia, sans-serif;
      background: linear-gradient(160deg, #5e1530 0%, #a02850 50%, #e05a82 100%) fixed;
    }

    /* ---------- background decorations ---------- */
    .float, .star, .confetti {
      position: fixed;
      pointer-events: none;
      user-select: none;
      z-index: 0;
    }

    .float {
      bottom: -60px;
      opacity: 0;
      animation: floatUp linear forwards;
    }

    @keyframes floatUp {
      0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
      10%  { opacity: 0.85; }
      90%  { opacity: 0.85; }
      100% { transform: translateY(-115vh) rotate(30deg); opacity: 0; }
    }

    .star {
      color: #ffe3ec;
      animation: twinkle 2.4s ease-in-out infinite;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.15; transform: scale(0.7); }
      50%      { opacity: 1;    transform: scale(1.2); }
    }

    .confetti {
      top: -40px;
      z-index: 5;
      animation: fall linear forwards;
    }

    @keyframes fall {
      to { transform: translateY(110vh) rotate(540deg); }
    }

    /* ---------- card ---------- */
    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 460px;
      padding: 48px 26px 30px;
      text-align: center;
      background: #fff7f8;
      border-radius: 28px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.4), 0 0 0 6px rgba(255, 255, 255, 0.18);
    }

    .card::before {
      content: "";
      position: absolute;
      inset: 9px;
      border: 2px dashed #f2b6c8;
      border-radius: 21px;
      pointer-events: none;
    }

    .card > * { position: relative; }

    .ribbon {
      position: absolute !important;
      top: -26px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 3rem;
      filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.25));
      animation: wiggle 3s ease-in-out infinite;
    }

    .corner {
      position: absolute !important;
      font-size: 1.6rem;
    }
    .corner.tl { top: 14px; left: 16px; }
    .corner.tr { top: 14px; right: 16px; }
    .corner.bl { bottom: 12px; left: 16px; }
    .corner.br { bottom: 12px; right: 16px; }

    @keyframes wiggle {
      0%, 100% { transform: translateX(-50%) rotate(-6deg); }
      50%      { transform: translateX(-50%) rotate(6deg); }
    }

    /* ---------- progress ---------- */
    .progress {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-bottom: 14px;
      font-size: 1.2rem;
      color: #f2b6c8;
    }
    .progress span.on { color: #d6335f; animation: beat 1.2s ease-in-out infinite; }
    .progress.hidden { display: none; }

    /* ---------- text ---------- */
    h1 {
      margin: 0 0 10px;
      font-family: "Pacifico", Georgia, cursive;
      font-weight: 400;
      font-size: 1.9rem;
      line-height: 1.35;
      color: #b8325f;
      text-shadow: 2px 2px 0 #ffd6e2;
    }

    p {
      margin: 0 0 22px;
      color: #6b3a4a;
      font-weight: 500;
      line-height: 1.6;
    }

    .mascot {
      display: block;
      margin-bottom: 8px;
      font-size: 4.2rem;
      animation: bounce 1.6s ease-in-out infinite;
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-10px); }
    }

    @keyframes beat {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.25); }
    }

    /* ---------- steps ---------- */
    .step { display: none; }
    .step.active { display: block; animation: pop 0.45s ease; }

    @keyframes pop {
      from { opacity: 0; transform: scale(0.92) translateY(10px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* ---------- buttons ---------- */
    button {
      border: none;
      border-radius: 999px;
      cursor: pointer;
      font-family: inherit;
      font-weight: 700;
    }

    button:disabled { opacity: 0.5; cursor: not-allowed; }

    .buttons {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    #yes {
      background: linear-gradient(135deg, #ff6b95, #d6335f);
      color: #fff;
      font-size: 1.1rem;
      padding: 12px 30px;
      box-shadow: 0 6px 14px rgba(214, 51, 95, 0.45);
      transition: font-size 0.3s, padding 0.3s;
      animation: beat 1.4s ease-in-out infinite;
    }

    #no {
      background: #ecd9df;
      color: #6b3a4a;
      font-size: 1rem;
      padding: 10px 22px;
    }

    .options {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 22px;
    }

    .option {
      padding: 14px 18px;
      font-size: 1.05rem;
      color: #6b3a4a;
      background: #fff;
      border: 2px dashed #f2a9c0;
      transition: transform 0.15s, background 0.15s;
    }

    .option:hover { transform: translateY(-2px) rotate(-1deg); background: #ffeaf0; }
    .option:active { transform: scale(0.97); }

    .option.selected {
      color: #fff;
      border-style: solid;
      border-color: #d6335f;
      background: linear-gradient(135deg, #ff6b95, #d6335f);
    }
    .option.selected::before { content: "♥ "; }

    .primary {
      padding: 13px 34px;
      font-size: 1.1rem;
      color: #fff;
      background: linear-gradient(135deg, #ff6b95, #d6335f);
      box-shadow: 0 6px 14px rgba(214, 51, 95, 0.4);
    }

    label {
      display: block;
      margin-bottom: 14px;
      text-align: left;
      font-weight: 700;
      color: #6b3a4a;
    }

    input, textarea {
      display: block;
      width: 100%;
      margin-top: 6px;
      padding: 11px 13px;
      font-family: inherit;
      font-size: 1rem;
      color: #6b3a4a;
      background: #fff;
      border: 2px solid #f2b6c8;
      border-radius: 14px;
    }

    input:focus, textarea:focus { outline: none; border-color: #d6335f; }
    textarea { min-height: 76px; resize: vertical; }

    #error { min-height: 1.3em; margin: 6px 0 12px; color: #b3123f; font-weight: 700; }

    /* ---------- finish ---------- */
    .summary {
      margin: 0 0 18px;
      padding: 14px 16px;
      list-style: none;
      text-align: left;
      color: #6b3a4a;
      line-height: 1.8;
      background: #ffeaf0;
      border-radius: 16px;
      border: 2px dashed #f2a9c0;
    }

    .footer {
      margin: 22px 0 0;
      font-size: 0.85rem;
      color: #b8325f;
    }

    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }
  </style>
</head>

<body>
  <div class="card">
    <span class="ribbon">🎀</span>
    <span class="corner tl">🌸</span>
    <span class="corner tr">🌸</span>
    <span class="corner bl">🌷</span>
    <span class="corner br">🌷</span>

    <div class="progress" id="progress"></div>

    <div class="step active" id="step-ask">
      <span class="mascot" id="mascot">🐻</span>
      <h1>Will you go on a date with me?</h1>
      <p>I made this just for you, my love 💕<br>Choose wisely...</p>
      <div class="buttons">
        <button id="yes">Yes! 💖</button>
        <button id="no">No</button>
      </div>
    </div>

    <div class="step" id="step-place">
      <span class="mascot">🗺️</span>
      <h1>Where should we go?</h1>
      <p>Pick your dream date spot ✨</p>
      <div class="options" id="places"></div>
    </div>

    <div class="step" id="step-acts">
      <span class="mascot">🧸</span>
      <h1>What should we do?</h1>
      <p>Pick as many as you like 💗</p>
      <div class="options" id="acts"></div>
      <button class="primary" id="acts-next" disabled>Next 💕</button>
    </div>

    <div class="step" id="step-when">
      <span class="mascot">💌</span>
      <h1>When are we going?</h1>
      <p>Choose a day and I'll take care of the rest 🌹</p>
      <label>Date <input type="date" id="date"></label>
      <label>Time <input type="time" id="time"></label>
      <label>A little note for me (optional)
        <textarea id="note" placeholder="Write me something sweet..."></textarea>
      </label>
      <div id="error"></div>
      <button class="primary" id="submit">Send to my love 💌</button>
    </div>

    <div class="step" id="step-done">
      <span class="mascot">🥰</span>
      <h1>Yay! It's a date!</h1>
      <p>Your answer is on its way to me 💖<br>Get ready, my love!</p>
      <ul class="summary" id="summary"></ul>
    </div>

    <p class="footer">made with 💗 just for you</p>
  </div>

  <script>
    // Put your email here. Answers are sent to it through FormSubmit.
    // shortcut: the email is visible in the page source, move to a backend to hide it.
    const EMAIL = "darren.raffazka@gmail.com";

    // Change the choices here!
    const places = ["Cozy cafe ☕", "Sunset at the beach 🏖️", "Movie theater 🎬", "Fancy dinner 🍝", "Picnic in the park 🧺", "Amusement park 🎡", "Shopping mall 🛍️"];
    const activities = ["Watch a movie 🎬", "Eat yummy food 🍜", "Take a stroll 🚶", "Take cute photos 📸", "Play games 🎮", "Sing karaoke 🎤", "Get ice cream 🍦", "Stargaze 🌌"];

    const state = { place: "", acts: [] };
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---------- background: floating hearts and twinkling stars ----------
    const floaters = ["💖", "💕", "💗", "💘", "🌸", "✨", "🌷", "🎀"];

    function spawnFloater() {
      const el = document.createElement("span");
      el.className = "float";
      el.textContent = floaters[Math.floor(Math.random() * floaters.length)];
      el.style.left = Math.random() * 100 + "vw";
      el.style.fontSize = (14 + Math.random() * 26) + "px";
      const duration = 9 + Math.random() * 8;
      el.style.animationDuration = duration + "s";
      el.addEventListener("animationend", function () { el.remove(); });
      document.body.appendChild(el);
    }

    function addStars() {
      for (let i = 0; i < 18; i++) {
        const s = document.createElement("span");
        s.className = "star";
        s.textContent = "✦";
        s.style.left = Math.random() * 100 + "vw";
        s.style.top = Math.random() * 100 + "vh";
        s.style.fontSize = (8 + Math.random() * 14) + "px";
        s.style.animationDelay = (Math.random() * 2.4) + "s";
        document.body.appendChild(s);
      }
    }

    if (!reduceMotion) {
      addStars();
      for (let i = 0; i < 8; i++) { setTimeout(spawnFloater, i * 500); }
      setInterval(spawnFloater, 900);
    }

    function burstConfetti() {
      if (reduceMotion) { return; }
      const pieces = ["💖", "💕", "🌸", "✨", "🎀", "💗", "🌷"];
      for (let i = 0; i < 45; i++) {
        const c = document.createElement("span");
        c.className = "confetti";
        c.textContent = pieces[Math.floor(Math.random() * pieces.length)];
        c.style.left = Math.random() * 100 + "vw";
        c.style.fontSize = (16 + Math.random() * 20) + "px";
        c.style.animationDuration = (3 + Math.random() * 3) + "s";
        c.style.animationDelay = (Math.random() * 1.5) + "s";
        c.addEventListener("animationend", function () { c.remove(); });
        document.body.appendChild(c);
      }
    }

    // ---------- steps and progress hearts ----------
    const order = ["ask", "place", "acts", "when"];
    const progress = document.getElementById("progress");

    function show(id) {
      document.querySelectorAll(".step").forEach(function (s) { s.classList.remove("active"); });
      document.getElementById("step-" + id).classList.add("active");

      const at = order.indexOf(id);
      progress.classList.toggle("hidden", at === -1);
      progress.innerHTML = "";
      order.forEach(function (_, i) {
        const dot = document.createElement("span");
        dot.textContent = i <= at ? "♥" : "♡";
        if (i <= at) { dot.className = "on"; }
        progress.appendChild(dot);
      });
    }
    show("ask");

    // ---------- step 1: the Yes button grows every time No is clicked ----------
    const yesButton = document.getElementById("yes");
    const noButton = document.getElementById("no");
    const mascot = document.getElementById("mascot");
    const noMessages = ["No", "Are you sure?", "Really?", "Think again!", "Please...", "Last chance...", "Just say yes!"];
    const sadFaces = ["🐻", "🥺", "🥺", "😢", "😭", "😭", "🥹"];
    let yesSize = 1.1;
    let noClicks = 0;

    noButton.addEventListener("click", function () {
      noClicks++;
      yesSize = Math.min(yesSize + 0.5, 3);
      yesButton.style.fontSize = yesSize + "rem";
      yesButton.style.padding = (yesSize * 10) + "px " + (yesSize * 22) + "px";
      noButton.textContent = noMessages[Math.min(noClicks, noMessages.length - 1)];
      mascot.textContent = sadFaces[Math.min(noClicks, sadFaces.length - 1)];
    });

    yesButton.addEventListener("click", function () { show("place"); });

    // ---------- step 2: pick a place (one choice, moves on right away) ----------
    const placesBox = document.getElementById("places");
    places.forEach(function (name) {
      const b = document.createElement("button");
      b.className = "option";
      b.textContent = name;
      b.addEventListener("click", function () {
        state.place = name;
        show("acts");
      });
      placesBox.appendChild(b);
    });

    // ---------- step 3: pick activities (many choices) ----------
    const actsBox = document.getElementById("acts");
    const actsNext = document.getElementById("acts-next");
    activities.forEach(function (name) {
      const b = document.createElement("button");
      b.className = "option";
      b.textContent = name;
      b.addEventListener("click", function () {
        const i = state.acts.indexOf(name);
        if (i === -1) { state.acts.push(name); } else { state.acts.splice(i, 1); }
        b.classList.toggle("selected");
        actsNext.disabled = state.acts.length === 0;
      });
      actsBox.appendChild(b);
    });
    actsNext.addEventListener("click", function () { show("when"); });

    // ---------- step 4: send the answers to email ----------
    const dateInput = document.getElementById("date");
    const submitButton = document.getElementById("submit");
    const errorBox = document.getElementById("error");

    const today = new Date();
    dateInput.min = today.getFullYear() + "-" +
      String(today.getMonth() + 1).padStart(2, "0") + "-" +
      String(today.getDate()).padStart(2, "0");

    function addSummaryLine(box, label, value) {
      const li = document.createElement("li");
      li.textContent = label + " " + value;
      box.appendChild(li);
    }

    submitButton.addEventListener("click", async function () {
      const date = dateInput.value;
      const time = document.getElementById("time").value;
      const note = document.getElementById("note").value;
      errorBox.textContent = "";

      if (!date || !time) {
        errorBox.textContent = "Please pick a date and a time 🥺";
        return;
      }
      if (EMAIL.indexOf("YOUR_EMAIL") === 0) {
        errorBox.textContent = "The email is not set in index.html yet";
        return;
      }

      submitButton.disabled = true;
      try {
        const res = await fetch("https://formsubmit.co/ajax/" + EMAIL, {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify({
            _subject: "She said YES to a date! 💖",
            _captcha: "false",
            Answer: "Yes!",
            Place: state.place,
            Activities: state.acts.join(", "),
            Date: date,
            Time: time,
            Note: note || "-"
          })
        });
        if (!res.ok) { throw new Error("send failed"); }

        const summary = document.getElementById("summary");
        addSummaryLine(summary, "📍", state.place);
        addSummaryLine(summary, "✨", state.acts.join(", "));
        addSummaryLine(summary, "🗓️", date + " at " + time);
        show("done");
        burstConfetti();
      } catch (e) {
        errorBox.textContent = "Couldn't send it, please try again 🥺";
        submitButton.disabled = false;
      }
    });
  </script>
</body>
</html>
